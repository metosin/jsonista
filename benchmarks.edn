{:benchmarks [{:name :encode
               :ns jsonista.jmh
               :fn [encode-data-json encode-cheshire encode-jsonista encode-jackson #_encode-jsonista-fast]
               :args [:state/edn]}
              {:name :decode
               :ns jsonista.jmh
               :fn [decode-data-json decode-cheshire decode-jsonista decode-jackson #_decode-jsonista-fast]
               :args [:state/json]}
              {:name :encode-kw
               :ns jsonista.jmh
               :fn [encode-data-json-kw encode-cheshire-kw encode-jsonista-kw]
               :args [:state/edn-kw]}
              {:name :encode-kw-bytes
               :ns jsonista.jmh
               :fn [encode-jsonista-kw-bytes]
               :args [:state/edn-kw]}
              {:name :decode-kw
               :ns jsonista.jmh
               :fn [decode-data-json-kw decode-cheshire-kw decode-jsonista-kw]
               :args [:state/json]}]
 :states {:json {:fn jsonista.jmh/json-data, :args [:param/size]}
          :edn {:fn jsonista.jmh/edn-data, :args [:param/size]}
          :edn-kw {:fn jsonista.jmh/edn-data-kw, :args [:param/size]}}
 :params {:size ["10b" "100b" "1k" "10k" "100k"]}
 :options {:jmh/default {:fork {:jvm {:append-args ["-Dclojure.compiler.direct-linking=true"]}}}}}
